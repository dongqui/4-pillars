# --- Auth (소셜 로그인) ---
AUTH_SESSION_SECRET=          # 세션 JWT 서명 키. openssl rand -base64 32
APP_ORIGIN=                   # 예: http://localhost:3000 (redirect_uri 조립용, 끝 슬래시 없이)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LINE_CLIENT_ID=               # LINE Login channel ID
LINE_CLIENT_SECRET=           # LINE channel secret

KAKAO_CLIENT_ID=              # 카카오 REST API 키
KAKAO_CLIENT_SECRET=          # (선택) 카카오 client secret 사용 시

# --- 익명 드래프트 저장소 ---
UPSTASH_REDIS_REST_URL=       # Upstash 콘솔 > Database > REST API
UPSTASH_REDIS_REST_TOKEN=

# --- 결제 (토스페이먼츠) ---
# 테스트/프로덕션 구분:
#   .env.local             개발(`npm run dev`) — 토스 "테스트" 키(test_ck_… / test_sk_…)
#   .env.production.local  프로덕션(`npm run build`/`start`) — "라이브" 키. .env.local 을 덮는다
#   배포 시                 호스팅 환경변수(Vercel 등)에 같은 키를 등록한다. .env* 는 커밋되지 않는다
# 토스는 키 자체가 테스트/라이브를 가른다 — 접두사(test_/live_)로 구분된다.
# 값이 없으면 /checkout 이 "결제를 준비 중입니다"로 잠긴다. 타입체크·테스트는 그대로 통과한다.
# NEXT_PUBLIC_ 을 쓰지 않는 이유는 src/lib/payments/config.ts 주석 참조.
#
# 2026-08-18: 포트원을 걷어내고 토스페이먼츠에 직접 붙였다. 옛 PORTONE_* 는 전부
# 없어졌다 — 옛 이름만 채워 둔 환경은 새 키를 못 읽어 조용히 "결제를 준비 중입니다"로
# 잠긴다. 웹훅 시크릿이 사라진 것은 누락이 아니다: 토스 웹훅에는 서명이 없어서
# 진위를 조회 API 로 확인한다(webhook/_lib/handler.ts 주석 참조).
#
# ⚠️ 키 계열을 반드시 "API 개별 연동"(test_ck_/test_sk_)으로 받는다. 개발자센터가 기본으로
# 보여주는 결제위젯 키(test_gck_/test_gsk_)를 넣으면 INVALID_API_KEY 로 결제창이 안 열린다.
# 위젯 키로 갈아타려면 코드도 위젯 SDK 로 바꿔야 하는데, 그러면 수단 선택 UI 를 토스 위젯에
# 넘기게 되어 체크아웃의 수단 버튼(카드/카카오페이/토스페이)이 사라진다. 우리는 간편결제
# 자체창을 직접 여는 쪽(card.flowMode = DIRECT)이라 개별 연동 키가 맞다.
TOSS_CLIENT_KEY=                  # 개발자센터 > API 키 > 클라이언트 키. 결제창을 여는 값이라 브라우저까지 내려간다
TOSS_SECRET_KEY=                  # 개발자센터 > API 키 > 시크릿 키. 승인·조회에 쓴다. 브라우저로 절대 내보내지 않는다
TOSS_METHODS=                     # 지금 열 수단: card,naver,kakao,toss 중 콤마로 나열. 비우면 결제 화면이 잠긴다
# 웹훅 엔드포인트는 개발자센터에 <APP_ORIGIN>/api/payments/webhook 으로 등록한다

# --- LLM (DeepSeek) ---
DEEPSEEK_API_KEY=            # 리포트 생성과 고민상담이 같은 키를 쓴다
